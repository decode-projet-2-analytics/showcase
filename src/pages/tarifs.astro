---
import Layout from "../layouts/Layout.astro";

const plans = [
  {
    name: "Starter",
    price: "0€",
    period: "/ mois",
    features: ["1 site", "Events de base", "7 jours d'historique"],
    featured: false,
  },
  {
    name: "Pro",
    price: "29€",
    period: "/ mois",
    features: ["10 sites", "Heatmaps + rétention", "12 mois d'historique"],
    featured: true,
  },
  {
    name: "Entreprise",
    price: "Sur devis",
    period: "",
    features: ["Sites illimités", "Support dédié", "Historique illimité"],
    featured: false,
  },
];
---

<Layout title="Tarifs">
  <section>
    <div class="container">
      <h1>Tarifs</h1>
      <p class="lead" style="margin-left:0">
        Trois offres fictives, avec un bouton par carte pour tester les clics.
      </p>

      <div class="grid">
        {
          plans.map((plan) => (
            <article class={plan.featured ? "card featured" : "card"}>
              <h3>{plan.name}</h3>
              <div class="price">
                {plan.price}
                {plan.period && <span>{plan.period}</span>}
              </div>
              <ul class="muted" style="padding-left:18px;margin:0 0 18px">
                {plan.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <button
                class={plan.featured ? "btn btn-primary" : "btn btn-ghost"}
                type="button"
                data-purchase-plan={plan.name}
              >
                Choisir {plan.name}
              </button>
            </article>
          ))
        }
      </div>

      <p id="purchase-status" class="purchase-status" role="status" aria-live="polite"></p>
    </div>
  </section>

  <script>
    const SESSION_KEY = "showcase-server-session-id";
    const status = document.querySelector<HTMLElement>("#purchase-status");
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-purchase-plan]");

    function getSessionId(): string {
      const existing = sessionStorage.getItem(SESSION_KEY);
      if (existing) return existing;

      const created = crypto.randomUUID();
      sessionStorage.setItem(SESSION_KEY, created);
      return created;
    }

    buttons.forEach((button) => {
      button.addEventListener("click", async () => {
        const plan = button.dataset.purchasePlan;
        if (!plan || !status) return;

        button.disabled = true;
        status.dataset.state = "loading";
        status.textContent = `Envoi de l'achat fictif ${plan}…`;

        try {
          const response = await fetch("/api/demo-purchase", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ plan, sessionId: getSessionId() }),
          });

          if (!response.ok) {
            throw new Error("Purchase rejected");
          }

          status.dataset.state = "success";
          status.textContent = `Achat fictif ${plan} enregistré : le TAG remonte dans le dashboard.`;
        } catch {
          status.dataset.state = "error";
          status.textContent = "L'événement serveur n'a pas pu être envoyé. Vérifiez la configuration et le TAG.";
        } finally {
          button.disabled = false;
        }
      });
    });
  </script>
</Layout>
