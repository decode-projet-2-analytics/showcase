# Variables lues par Astro/Vite. Le préfixe PUBLIC_ est OBLIGATOIRE pour
# qu'elles soient exposées au navigateur (le SDK tourne côté client).
#
# Copiez ce fichier en `.env` et renseignez vos valeurs.

# URL du endpoint de collecte de votre backend d'analytics.
# (Le backend en Docker est exposé sur le port hôte 3008 ; route montée sous /api/v1.)
PUBLIC_SDK_ENDPOINT="http://localhost:3008/api/v1/collect"

# appId de l'application (visible dans le backoffice, onglet Applications).
PUBLIC_SDK_APP_ID=""
